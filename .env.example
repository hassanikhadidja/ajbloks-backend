# Copy to .env for local development only.
# On Railway, add these in: Project → Service → Variables

uri=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/BackendDB?ssl=true&replicaSet=...&authSource=admin
# Alternative names also supported: MONGODB_URI, MONGO_URI

secretKey=replace-with-a-long-random-secret
# Alternative names also supported: JWT_SECRET, SECRET_KEY

PORT=5000

CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=
